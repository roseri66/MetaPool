<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.roseri66</groupId>
    <artifactId>metapool-parent</artifactId>
    <version>2.3.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>MetaPool Parent</name>
    <description>MetaPool — Java 资源治理控制面：把 HikariCP/Bucket4j 等异构资源管理器纳入统一的生命周期、可观测、动态调参门面</description>
    <url>https://github.com/roseri66/MetaPool</url>

    <licenses>
        <license>
            <name>The Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>roseri66</id>
            <name>roseri66</name>
            <url>https://github.com/roseri66</url>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/roseri66/MetaPool.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/roseri66/MetaPool.git</developerConnection>
        <url>https://github.com/roseri66/MetaPool</url>
    </scm>

    <modules>
        <module>metapool-bom</module>
        <module>metapool-common</module>
        <module>metapool-core</module>
        <module>metapool-adapter-hikari</module>
        <module>metapool-adapter-bucket4j</module>
        <module>metapool-adapter-jdk-executor</module>
        <module>metapool-adapter-redisson</module>
        <module>metapool-adapter-commons-pool2</module>
        <module>metapool-spring-starter</module>
        <module>metapool-examples</module>
        <module>metapool-benchmark</module>
        <!--
            后续扩展：为更多资源类型各写一个治理适配器（新模块），SPI 自动发现即可：
              redis(Lettuce) / object(Commons-Pool2) / executor(JDK) / lock(Redisson) / memory(Netty)
            1.0 的自研池实现已删除；如需参考见 git 历史与 v1.0.0 标签。
        -->
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>
        <maven.compiler.source>17</maven.compiler.source>
        <maven.compiler.target>17</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!--
            框架版本锁定。
            注意：不要在这里钉 micrometer 版本 —— micrometer-core 由 spring-boot-dependencies 管，
            单独钉 micrometer-registry-prometheus 会造成各 micrometer 模块版本错配（曾 core 1.14.4
            对 registry 1.14.5），而 Micrometer 要求同版本。见坑 P-16。
        -->
        <spring-boot.version>3.4.3</spring-boot.version>
        <bucket4j.version>8.9.0</bucket4j.version>
        <postgresql-driver.version>42.7.5</postgresql-driver.version>
        <testcontainers.version>1.20.6</testcontainers.version>
        <!--
            Testcontainers 内置的 docker-java 默认按 Docker API 1.32 发请求，而 Docker Engine 29.x
            的最低 API 是 1.40 → /info 直接 400，Testcontainers 判定「没有 Docker」并把集成测试
            **静默跳过**（构建仍是绿的，极易被误认为通过）。见坑 P-22。

            取 1.40 而非更高：它同时是新引擎的下限与老引擎（19.03+）支持范围内的值，
            两头都兼容，是最保守的选择。实测 1.21.3 也有同样问题，升版本解决不了，故未升。
        -->
        <docker.api.version>1.40</docker.api.version>

        <!-- 测试 -->
        <junit.version>5.11.4</junit.version>
        <mockito.version>5.14.2</mockito.version>
        <jmh.version>1.37</jmh.version>

        <hikaricp.version>5.1.0</hikaricp.version>
        <!--
            Redisson 不在 spring-boot-dependencies 里，故自设版本（这不违反坑 P-16 ——
            P-16 说的是「Boot BOM 已管的坐标别自设」）。它传递的 netty / jackson 仍由 Boot BOM 统一管，
            升级 Redisson 时须复核这两族的最终版本没被拽偏。
        -->
        <redisson.version>3.35.0</redisson.version>
        <commons-pool2.version>2.12.1</commons-pool2.version>
        <h2.version>2.2.224</h2.version>

        <!-- 插件 -->
        <maven-enforcer-plugin.version>3.5.0</maven-enforcer-plugin.version>
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
        <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
        <jacoco.version>0.8.12</jacoco.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- micrometer-core / micrometer-registry-prometheus 版本全部由上面的 spring-boot-dependencies 统一管理 -->

            <!-- Bucket4j：metapool-adapter-bucket4j 的编译期依赖 -->
            <dependency>
                <groupId>com.bucket4j</groupId>
                <artifactId>bucket4j-core</artifactId>
                <version>${bucket4j.version}</version>
            </dependency>

            <!-- PostgreSQL JDBC Driver -->
            <dependency>
                <groupId>org.postgresql</groupId>
                <artifactId>postgresql</artifactId>
                <version>${postgresql-driver.version}</version>
            </dependency>

            <!-- Testcontainers -->
            <dependency>
                <groupId>org.testcontainers</groupId>
                <artifactId>testcontainers</artifactId>
                <version>${testcontainers.version}</version>
                <scope>test</scope>
            </dependency>

            <!-- JUnit 5 -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>

            <!-- Mockito -->
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-core</artifactId>
                <version>${mockito.version}</version>
                <scope>test</scope>
            </dependency>

            <!-- JMH -->
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-core</artifactId>
                <version>${jmh.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.openjdk.jmh</groupId>
                <artifactId>jmh-generator-annprocess</artifactId>
                <version>${jmh.version}</version>
                <scope>test</scope>
            </dependency>

            <!-- Commons Pool2：metapool-adapter-commons-pool2 的编译期依赖 -->
            <dependency>
                <groupId>org.apache.commons</groupId>
                <artifactId>commons-pool2</artifactId>
                <version>${commons-pool2.version}</version>
            </dependency>

            <!-- Redisson：metapool-adapter-redisson 的编译期依赖 -->
            <dependency>
                <groupId>org.redisson</groupId>
                <artifactId>redisson</artifactId>
                <version>${redisson.version}</version>
            </dependency>

            <!-- HikariCP：metapool-adapter-hikari 的编译期依赖 -->
            <dependency>
                <groupId>com.zaxxer</groupId>
                <artifactId>HikariCP</artifactId>
                <version>${hikaricp.version}</version>
            </dependency>
            <!-- H2：测试与 examples/benchmark 的内存库 -->
            <dependency>
                <groupId>com.h2database</groupId>
                <artifactId>h2</artifactId>
                <version>${h2.version}</version>
                <scope>test</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!--
                JDK 版本守门（坑 P-03 的根治）。本机用户级 JAVA_HOME 长期指向 JDK 8，
                而 javac 的原生报错「无效的目标发行版: 17」完全不提是哪个 JDK、在哪，
                导致同一个坑踩了两次。这里在 validate 阶段就拦下并打印可操作的信息。
                只做检查，不改任何产物内容。
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>${maven-enforcer-plugin.version}</version>
                <executions>
                    <execution>
                        <id>enforce-jdk17</id>
                        <goals><goal>enforce</goal></goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[17,)</version>
                                    <!--
                                        故意用纯 ASCII 英文：这条消息只在「跑错 JDK」时出现，
                                        而那时往往正是 JDK 8 + GBK 控制台，中文会变成乱码 ——
                                        一条只在它唯一的失败场景下读不出来的提示等于没写。
                                        中文详解在 docs/RULES.md 台账 P-03。
                                    -->
                                    <message>
MetaPool requires JDK 17+ to build. Your JAVA_HOME points at an older JDK.

This machine has both JDK 8 (C:\Program Files\Java\jdk-1.8) and JDK 17
(C:\Program Files\ojdkbuild\java-17-openjdk-17.0.3.0.6-1) installed, and shells
have repeatedly come up on JDK 8. Set it for the current shell:

  PowerShell : $env:JAVA_HOME = "C:\Program Files\ojdkbuild\java-17-openjdk-17.0.3.0.6-1"
  Git Bash   : export JAVA_HOME='/c/Program Files/ojdkbuild/java-17-openjdk-17.0.3.0.6-1'

Then run 'mvn -v' and confirm it prints "Java version: 17.x" before continuing.
See docs/RULES.md pitfall P-03 for the full story.
                                    </message>
                                </requireJavaVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>

        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven-compiler-plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <encoding>${project.build.sourceEncoding}</encoding>
                        <!-- 保留方法参数名：Spring Actuator @WriteOperation 参数绑定依赖它 -->
                        <parameters>true</parameters>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven-surefire-plugin.version}</version>
                    <configuration>
                        <argLine>-Xms256m -Xmx1024m</argLine>
                        <excludes>
                            <exclude>**/*Benchmark*</exclude>
                        </excludes>
                        <systemPropertyVariables>
                            <!--
                                告诉 Testcontainers 内置的 docker-java 用哪个 Docker API 版本。
                                不设的话它默认 1.32，被 Docker Engine 29.x（最低 1.40）拒为 400，
                                于是集成测试被静默跳过而构建仍然是绿的（坑 P-22）。
                            -->
                            <api.version>${docker.api.version}</api.version>
                        </systemPropertyVariables>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven-jar-plugin.version}</version>
                </plugin>
                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.version}</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <profiles>
        <!--
            发布到 Maven Central 用：mvn -Prelease clean deploy
            需先配置：~/.m2/settings.xml 的 server id=central（Sonatype Central token）+ 本地 GPG 密钥。
            平时构建不激活本 profile，因此不依赖 GPG。详见 docs/PUBLISHING.md。
        -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals><goal>jar-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.7.0</version>
                        <configuration>
                            <doclint>none</doclint>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals><goal>jar</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.4</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.11.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>false</autoPublish>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
