{
  "annotations": {
    "list": []
  },
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "title": "MetaPool — Resource Governance Overview",
  "uid": "metapool-overview",
  "tags": [
    "metapool"
  ],
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "refresh": "10s",
  "templating": {
    "list": [
      {
        "name": "resource",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(metapool_resource)",
        "includeAll": true,
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Datasource (连接池)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "timeseries",
      "title": "Connections by state",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "metapool_datasource_connections_active{metapool_resource=~\"$resource\"}",
          "legendFormat": "{{metapool_resource}} · active"
        },
        {
          "refId": "B",
          "expr": "metapool_datasource_connections_idle{metapool_resource=~\"$resource\"}",
          "legendFormat": "{{metapool_resource}} · idle"
        },
        {
          "refId": "C",
          "expr": "metapool_datasource_connections{metapool_resource=~\"$resource\"}",
          "legendFormat": "{{metapool_resource}} · total"
        },
        {
          "refId": "D",
          "expr": "metapool_datasource_connections_pending{metapool_resource=~\"$resource\"}",
          "legendFormat": "{{metapool_resource}} · pending"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Pending acquisitions",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(metapool_datasource_connections_pending{metapool_resource=~\"$resource\"})",
          "legendFormat": "pending"
        }
      ]
    },
    {
      "type": "row",
      "title": "Rate limiter (限流)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      }
    },
    {
      "type": "timeseries",
      "title": "Available tokens",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "metapool_ratelimiter_available_tokens",
          "legendFormat": "{{metapool_resource}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Acquire vs Reject (per second)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 8,
        "y": 10
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "reqps"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*reject.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (metapool_resource) (rate(metapool_ratelimiter_acquired_total[1m]))",
          "legendFormat": "{{metapool_resource}} · acquired"
        },
        {
          "refId": "B",
          "expr": "sum by (metapool_resource) (rate(metapool_ratelimiter_rejected_total[1m]))",
          "legendFormat": "{{metapool_resource}} · rejected"
        }
      ]
    },
    {
      "type": "row",
      "title": "Executor (线程池)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Threads: active vs pool size",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "metapool_executor_active{metapool_resource=~\"$resource\"}",
          "legendFormat": "{{metapool_resource}} · active"
        },
        {
          "refId": "B",
          "expr": "metapool_executor_pool_size{metapool_resource=~\"$resource\"}",
          "legendFormat": "{{metapool_resource}} · pool size"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Queue depth",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "metapool_executor_queue_size{metapool_resource=~\"$resource\"}",
          "legendFormat": "{{metapool_resource}} · queued"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Completed vs Rejected (per second)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 19
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "reqps"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*reject.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (metapool_resource) (rate(metapool_executor_completed_total[1m]))",
          "legendFormat": "{{metapool_resource}} · completed"
        },
        {
          "refId": "B",
          "expr": "sum by (metapool_resource) (rate(metapool_executor_rejected_total[1m]))",
          "legendFormat": "{{metapool_resource}} · rejected"
        }
      ]
    },
    {
      "type": "row",
      "title": "Distributed lock (分布式锁)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 27
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Locks held (this process)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "metapool_lock_held{metapool_resource=~\"$resource\"}",
          "legendFormat": "{{metapool_resource}} · held"
        }
      ],
      "description": "本进程当前持有的锁数量。\n\n注意这是**进程内**视角 —— 分布式锁的全局持有情况要问 Redis，不是进程内控制面能回答的（ResourceManager 是进程内对象，RULES §2.7）。\n\n该值长期不归零 = 有凭证没被 close()。"
    },
    {
      "type": "timeseries",
      "title": "Acquire vs Timeout (per second)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "reqps"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*timeout.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (metapool_resource) (rate(metapool_lock_acquired_total[1m]))",
          "legendFormat": "{{metapool_resource}} · acquired"
        },
        {
          "refId": "B",
          "expr": "sum by (metapool_resource) (rate(metapool_lock_timeout_total[1m]))",
          "legendFormat": "{{metapool_resource}} · timeout"
        }
      ],
      "description": "timeout = 在 waitTime 内没拿到锁。\n\n持续偏高说明锁竞争激烈：要么临界区太长，要么锁粒度太粗。"
    },
    {
      "type": "timeseries",
      "title": "Lease expiry (per second)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "reqps"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (metapool_resource) (rate(metapool_lock_lease_expired_total[1m]))",
          "legendFormat": "{{metapool_resource}} · lease expired"
        }
      ],
      "description": "🔴 **正常情况下应恒为 0。**\n\n不为 0 意味着业务执行超过了租约：锁已自动释放、另一个进程可能已拿到同一把锁，而 MetaPool 的 DistributedLock 不提供 fencing token，下游无法拒绝过期持有者的迟到写入。\n\n处置：调大 leaseTime（建议为业务耗时的 3~5 倍）或缩短临界区。完整论证见 docs/design/adapter-redisson.md。\n\n口径说明：这是**近似值** —— 真正的到期发生在 Redis 侧，进程内只能在 close() 时发现「锁已不归我们」。"
    }
  ]
}
