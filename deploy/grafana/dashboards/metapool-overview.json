      "description": "timeout = 在 waitTime 内没拿到锁。\n\n持续偏高说明锁竞争激烈：要么临界区太长，要么锁粒度太粗。"
    },
    {
      "type": "timeseries",
      "title": "Lease expiry (per second)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 28
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never"
          },
          "unit": "reqps"
