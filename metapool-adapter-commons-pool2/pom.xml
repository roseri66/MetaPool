<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.roseri66</groupId>
        <artifactId>metapool-parent</artifactId>
        <version>2.2.0-SNAPSHOT</version>
    </parent>

    <artifactId>metapool-adapter-commons-pool2</artifactId>
    <packaging>jar</packaging>

    <name>MetaPool Adapter :: Commons Pool2</name>
    <description>把 Apache Commons Pool2 通用对象池纳入 MetaPool 治理面的适配器（OBJECT 类型）</description>

    <dependencies>
        <dependency>
            <groupId>io.github.roseri66</groupId>
            <artifactId>metapool-common</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 被包装的成熟库 -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>

        <!--
            测试用内存对象工厂即可，不需要 Docker —— 本模块的测试在任何环境都全跑。
        -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
