<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.roseri66</groupId>
        <artifactId>metapool-parent</artifactId>
        <version>2.5.0-SNAPSHOT</version>
    </parent>

    <artifactId>metapool-adapter-netty</artifactId>
    <packaging>jar</packaging>

    <name>MetaPool Adapter :: Netty ByteBuf</name>
    <description>把 Netty 的池化堆外内存纳入 MetaPool 治理面的适配器（MEMORY 类型；release 是减引用计数）</description>

    <dependencies>
        <dependency>
            <groupId>io.github.roseri66</groupId>
            <artifactId>metapool-common</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 被包装的成熟库。版本由 spring-boot-dependencies 的 netty-bom 统一管，不自设（P-16） -->
        <dependency>
            <groupId>io.netty</groupId>
            <artifactId>netty-buffer</artifactId>
        </dependency>

        <!-- 测试全在内存里跑，不需要 Docker -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
