<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.roseri66</groupId>
        <artifactId>metapool-parent</artifactId>
        <version>2.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>metapool-examples</artifactId>
    <packaging>jar</packaging>

    <name>MetaPool Examples</name>
    <description>可运行的 Spring Boot 示例：同时纳管 datasource + rate-limiter + executor，暴露 /actuator/metapool 与 Prometheus</description>

    <properties>
        <!-- 示例应用不发布到 Maven Central -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.roseri66</groupId>
            <artifactId>metapool-spring-starter</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- 用到的资源类型对应的 adapter（SPI 自动发现） -->
        <dependency>
            <groupId>io.github.roseri66</groupId>
            <artifactId>metapool-adapter-hikari</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.roseri66</groupId>
            <artifactId>metapool-adapter-bucket4j</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>io.github.roseri66</groupId>
            <artifactId>metapool-adapter-jdk-executor</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <!-- demo 用 H2，开箱即跑，无需外部数据库 -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <!--
                        本项目不以 spring-boot-starter-parent 为父 pom，repackage 不会自动绑定，
                        必须显式声明 —— 否则 mvn package 只产出瘦 jar，java -jar 跑不起来。
                    -->
                    <execution>
                        <goals><goal>repackage</goal></goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
