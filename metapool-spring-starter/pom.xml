<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.roseri66</groupId>
        <artifactId>metapool-parent</artifactId>
        <version>2.4.0-SNAPSHOT</version>
    </parent>

    <artifactId>metapool-spring-starter</artifactId>
    <packaging>jar</packaging>

    <name>MetaPool Spring Boot Starter</name>
    <description>Spring Boot 接入层 — YAML 声明式纳管、控制面自动装配、指标绑定、health/tune Actuator 端点</description>

    <dependencies>
        <!-- 控制面（含 common） -->
        <dependency>
            <groupId>io.github.roseri66</groupId>
            <artifactId>metapool-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- 适配器：可选，用户按需引入所用资源类型的 adapter jar（SPI 自动发现） -->
        <dependency>
            <groupId>io.github.roseri66</groupId>
            <artifactId>metapool-adapter-hikari</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.github.roseri66</groupId>
            <artifactId>metapool-adapter-bucket4j</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.github.roseri66</groupId>
            <artifactId>metapool-adapter-jdk-executor</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.github.roseri66</groupId>
            <artifactId>metapool-adapter-redisson</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.github.roseri66</groupId>
            <artifactId>metapool-adapter-commons-pool2</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>io.github.roseri66</groupId>
            <artifactId>metapool-adapter-lettuce</artifactId>
            <version>${project.version}</version>
            <optional>true</optional>
        </dependency>

        <!-- Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            测试：两个适配器不在此重复声明 —— 上面 optional 的 compile 依赖本来就在测试 classpath 上。
            重复声明会触发 Maven「must be unique」告警，且后一条 test scope 会覆盖掉前一条，
            把 <optional>true</optional> 静默吃掉（坑 P-10，P-05 家族）。
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- micrometer-core 由 metapool-core→common 以 compile 传递而来（SimpleMeterRegistry 测试可见） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
